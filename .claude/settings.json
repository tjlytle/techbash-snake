{
  "plansDirectory": "./.claude/plans",
  "enabledPlugins": {
    "gh-personas@dev-flow": true,
    "superpowers@claude-plugins-official": true,
    "build@initialcommit": true,
    "but-for-real@initialcommit": true
  },
  "extraKnownMarketplaces": {
    "dev-flow": {
      "source": {
        "source": "github",
        "repo": "tjlytle/dev-flow"
      }
    },
    "initialcommit": {
      "source": {
        "source": "github",
        "repo": "tjlytle/initialcommit-skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(make test *)",
      "Bash(make behat *)",
      "Bash(make build *)",
      "Bash(make install *)",
      "Bash(make composer *)",
      "Bash(docker compose *)",
      "Bash(gh-as *)",
      "Bash(gh-personas *)"
    ]
  }
}
