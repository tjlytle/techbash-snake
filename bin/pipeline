#!/usr/bin/env bash
# bin/pipeline — the agent pipeline for the talk.
#
#   bin/pipeline            watch open issues forever; run each stage's prompt as it is due
#   bin/pipeline --once     one pass over the open issues, then exit
#   bin/pipeline <#>        run the due stage for one issue now (foreground)
#
# Stages are labels. The loop decides nothing; it maps a label to a prompt file and
# runs that prompt in a headless Claude Code session for the issue:
#
#   stage:todo          backlog, untouched
#   stage:in-progress   pipeline/build.md   (builder: worktree, test, code, draft PR)
#   stage:review        pipeline/review.md  (reviewer: read the PR, approve or send back)
#   stage:qa            pipeline/qa.md      (qa: run every suite, mark ready or send back)
#   stage:done          merged or ready to merge; nothing to do
#   stage:parked        waiting on a human; picked up again when the newest comment is
#                       from a human, and then handed back to the build prompt
#
# The headless session gets the tool allow list below and nothing more: file edits are
# accepted, and only the listed commands run. A command outside the list is denied and
# the stage stops with that denial in its log, which is the signal to widen the list.
#
# Logs: var/pipeline/<#>.log ; a run marker: var/pipeline/running-<#>/
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
REPO=${PIPELINE_REPO:-tjlytle/techbash-snake}
INTERVAL=${PIPELINE_INTERVAL:-30}
MODEL=${PIPELINE_MODEL:-opus}
LOG="$ROOT/var/pipeline"
mkdir -p "$LOG"

ALLOW=(
  "Read" "Edit" "Write" "MultiEdit" "Glob" "Grep" "Agent" "Skill" "TodoWrite"
  "Bash(gh-as *)" "Bash(gh-personas *)" "Bash(gh *)" "Bash(git *)"
  "Bash(make *)" "Bash(docker compose *)"
  "Bash(ls *)" "Bash(cat *)" "Bash(head *)" "Bash(tail *)" "Bash(sed *)" "Bash(grep *)"
  "Bash(find *)" "Bash(wc *)" "Bash(jq *)" "Bash(diff *)" "Bash(mkdir *)" "Bash(cp *)"
  "Bash(cd *)" "Bash(pwd)" "Bash(echo *)" "Bash(date *)" "Bash(test *)" "Bash(true)" "Bash(sleep *)"
)

say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }

prompt_for() {   # prompt_for <labels-csv> → prompt file name, or empty when nothing is due
  case ",$1," in
    *,stage:in-progress,*) echo build ;;
    *,stage:review,*)      echo review ;;
    *,stage:qa,*)          echo qa ;;
    *)                     echo "" ;;
  esac
}

answered() {   # answered <#>: a parked issue whose newest comment is from a human
  local last
  last=$(gh api "repos/$REPO/issues/$1/comments" \
           --jq 'if length == 0 then "" else (last.user.login + " " + last.user.type) end' 2>/dev/null)
  [[ "$last" == *" User" ]]
}

run_stage() {   # run_stage <#> <title> <prompt>  — foreground, logs to var/pipeline/<#>.log
  local n=$1 title=$2 stage=$3 mark="$LOG/running-$1"
  mkdir "$mark" 2>/dev/null || { say "#$n already running"; return 0; }
  say "#$n  $title  → $stage ($MODEL)" | tee -a "$LOG/$n.log"
  ( cd "$ROOT" && claude -p "$(sed "s/{N}/$n/g" "$ROOT/pipeline/$stage.md")" \
      --model "$MODEL" --permission-mode acceptEdits --allowedTools "${ALLOW[@]}" \
      --output-format text 2>&1 | sed -u "s/^/  #$n │ /" | tee -a "$LOG/$n.log" )
  say "#$n  $stage finished" | tee -a "$LOG/$n.log"
  rmdir "$mark"
}

due() {   # due <#> <labels-csv> → stage to run, or empty
  local n=$1 labels=$2 stage
  stage=$(prompt_for "$labels")
  if [ -z "$stage" ] && [[ ",$labels," == *,stage:parked,* ]] && answered "$n"; then
    gh-as - issue edit "$n" -R "$REPO" --remove-label stage:parked --add-label stage:in-progress >/dev/null 2>&1
    stage=build
  fi
  echo "$stage"
}

pass() {   # one sweep over the open issues
  while IFS=$'\t' read -r n title labels; do
    [ -z "$n" ] && continue
    if [ -d "$LOG/running-$n" ]; then say "#$n  $title  (running)"; continue; fi
    stage=$(due "$n" "$labels")
    if [ -n "$stage" ]; then run_stage "$n" "$title" "$stage" &
    else say "#$n  $title  [${labels:-no stage}]"; fi
  done < <(gh issue list -R "$REPO" --state open --limit 50 \
             --json number,title,labels \
             --jq '.[] | [.number, .title, ([.labels[].name] | join(","))] | @tsv')
  wait
}

case "${1:-}" in
  "")      say "watching $REPO every ${INTERVAL}s (ctrl-c to stop)"
           while true; do pass; sleep "$INTERVAL"; done ;;
  --once)  pass ;;
  [0-9]*)  labels=$(gh issue view "$1" -R "$REPO" --json labels --jq '[.labels[].name] | join(",")')
           title=$(gh issue view "$1" -R "$REPO" --json title --jq .title)
           stage=$(due "$1" "$labels")
           [ -n "$stage" ] && run_stage "$1" "$title" "$stage" || say "#$1 has nothing due [$labels]" ;;
  *)       sed -n '2,24p' "$0"; exit 2 ;;
esac
